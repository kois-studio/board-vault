{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "frontend": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss"
                }
            },
            "root": "",
            "sourceRoot": "src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "outputPath": "dist/frontend",
                        "index": "src/index.html",
                        "browser": "src/main.ts",
                        "polyfills": [
                            "zone.js",
                            "@angular/localize/init"
                        ],
                        "tsConfig": "tsconfig.app.json",
                        "inlineStyleLanguage": "scss",
                        "assets": [
                            {
                                "glob": "**/*",
                                "input": "public"
                            }
                        ],
                        "styles": [
                            "src/styles.css"
                        ],
                        "scripts": []
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "1MB",
                                    "maximumError": "1.25MB"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "2kB",
                                    "maximumError": "4kB"
                                }
                            ],
                            "outputHashing": "all",
                            "localize": true,
                            "i18nMissingTranslation": "error"
                        },
                        "development": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true,
                            "fileReplacements": [
                                {
                                    "replace": "src/environments/environment.ts",
                                    "with": "src/environments/environment.development.ts"
                                }
                            ]
                        },
                        "es": {
                            "localize": [
                                "es"
                            ],
                            "i18nMissingTranslation": "error"
                        },
                        "fr": {
                            "localize": [
                                "fr"
                            ],
                            "i18nMissingTranslation": "error"
                        },
                        "de": {
                            "localize": [
                                "de"
                            ],
                            "i18nMissingTranslation": "error"
                        },
                        "it": {
                            "localize": [
                                "it"
                            ],
                            "i18nMissingTranslation": "error"
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "configurations": {
                        "production": {
                            "buildTarget": "frontend:build:production"
                        },
                        "development": {
                            "buildTarget": "frontend:build:development"
                        },
                        "es": {
                            "buildTarget": "frontend:build:development,es"
                        },
                        "fr": {
                            "buildTarget": "frontend:build:development,fr"
                        },
                        "de": {
                            "buildTarget": "frontend:build:development,de"
                        },
                        "it": {
                            "buildTarget": "frontend:build:development,it"
                        }
                    },
                    "defaultConfiguration": "development"
                },
                "extract-i18n": {
                    "builder": "ng-extract-i18n-merge:ng-extract-i18n-merge",
                    "options": {
                        "buildTarget": "frontend:build",
                        "format": "xlf2",
                        "outputPath": "src/locale",
                        "sourceFile": "messages.xlf",
                        "targetFiles": [
                            "messages.es.xlf",
                            "messages.fr.xlf",
                            "messages.de.xlf",
                            "messages.it.xlf"
                        ],
                        "newTranslationTargetsBlank": "omit",
                        "fuzzyMatch": false,
                        "resetTranslationState": true,
                        "sort": "stableAlphabetNew",
                        "includeContext": "sourceFileOnly",
                        "includeMeaningAndDescription": true,
                        "collapseWhitespace": true,
                        "trim": false,
                        "includeContextLineNumber": false
                    }
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "tsConfig": "tsconfig.spec.json",
                        "buildTarget": "::development"
                    }
                }
            },
            "i18n": {
                "sourceLocale": {
                    "code": "en",
                    "subPath": "en"
                },
                "locales": {
                    "es": {
                        "translation": "src/locale/messages.es.xlf",
                        "subPath": "es"
                    },
                    "fr": {
                        "translation": "src/locale/messages.fr.xlf",
                        "subPath": "fr"
                    },
                    "de": {
                        "translation": "src/locale/messages.de.xlf",
                        "subPath": "de"
                    },
                    "it": {
                        "translation": "src/locale/messages.it.xlf",
                        "subPath": "it"
                    }
                }
            }
        }
    },
    "cli": {
        "analytics": "b10653b6-9d1e-4056-b167-17d4239a3b70"
    },
    "schematics": {
        "@schematics/angular:component": {
            "type": "component"
        },
        "@schematics/angular:directive": {
            "type": "directive"
        },
        "@schematics/angular:service": {
            "type": "service"
        },
        "@schematics/angular:guard": {
            "typeSeparator": "."
        },
        "@schematics/angular:interceptor": {
            "typeSeparator": "."
        },
        "@schematics/angular:module": {
            "typeSeparator": "."
        },
        "@schematics/angular:pipe": {
            "typeSeparator": "."
        },
        "@schematics/angular:resolver": {
            "typeSeparator": "."
        }
    }
}
