{
    "name": "frontend",
    "version": "0.1.0-beta.1",
    "scripts": {
        "ng": "ng",
        "prestart": "node scripts/generate-runtime-config.mjs",
        "start": "ng serve",
        "predev": "node scripts/generate-runtime-config.mjs",
        "dev": "ng serve",
        "e2e": "playwright test",
        "e2e:ui": "playwright test --ui",
        "prebuild": "node scripts/generate-runtime-config.mjs",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "lint:check": "biome check src/app src/styles.css",
        "format": "biome check --write",
        "format-fix-unsafe": "biome check --fix --unsafe"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "22.2.0",
        "@angular/common": "22.2.0",
        "@angular/compiler": "22.2.0",
        "@angular/core": "22.2.0",
        "@angular/forms": "22.2.0",
        "@angular/platform-browser": "22.2.0",
        "@angular/platform-browser-dynamic": "22.2.0",
        "@angular/router": "22.2.0",
        "@clerk/clerk-js": "6.34.1",
        "@lucide/angular": "^1.48.0",
        "@tailwindcss/postcss": "^4.3.3",
        "rxjs": "~7.8.1",
        "tslib": "^2.7.0",
        "zod": "3.23.8",
        "zone.js": "^0.16.3"
    },
    "devDependencies": {
        "@angular/build": "^22.2.0",
        "@angular/cli": "22.2.0",
        "@angular/compiler-cli": "22.2.0",
        "@angular/localize": "22.2.0",
        "@biomejs/biome": "2.5.14",
        "@clerk/backend": "^3.21.0",
        "@clerk/testing": "^2.2.40",
        "@playwright/test": "^1.63.0",
        "autoprefixer": "^10.6.1",
        "jsdom": "^30.1.1",
        "postcss": "^8.4.47",
        "postcss-nested": "^8.0.1",
        "tailwindcss": "^4.3.3",
        "typescript": "~7.0.2",
        "utf-8-validate": "^5.0.10",
        "vitest": "^5.0.3"
    },
    "overrides": {
        "image-size": "2.0.3",
        "jayson": {
            "stream-json": "3.5.0",
            "uuid": "11.1.1"
        }
    },
    "engines": {
        "node": "24.x"
    }
}
