{
    "name": "frontend",
    "version": "0.1.0-beta.1",
    "scripts": {
        "ng": "ng",
        "prestart": "node scripts/generate-runtime-config.mjs",
        "start": "ng serve",
        "start:es": "node scripts/generate-runtime-config.mjs && ng serve --configuration=development,es",
        "start:fr": "node scripts/generate-runtime-config.mjs && ng serve --configuration=development,fr",
        "start:de": "node scripts/generate-runtime-config.mjs && ng serve --configuration=development,de",
        "start:it": "node scripts/generate-runtime-config.mjs && ng serve --configuration=development,it",
        "predev": "node scripts/generate-runtime-config.mjs",
        "dev": "ng serve",
        "e2e": "playwright test",
        "e2e:ui": "playwright test --ui",
        "prebuild": "node scripts/generate-runtime-config.mjs && node scripts/i18n-translations.mjs check",
        "build": "ng build",
        "postbuild": "node scripts/assemble-locales.mjs",
        "i18n:extract": "ng extract-i18n",
        "i18n:missing": "node scripts/i18n-translations.mjs missing",
        "i18n:apply": "node scripts/i18n-translations.mjs apply",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "lint:check": "biome check src/app src/styles.css",
        "format": "biome check --write",
        "format-fix-unsafe": "biome check --fix --unsafe"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "22.2.3",
        "@angular/common": "22.2.3",
        "@angular/compiler": "22.2.3",
        "@angular/core": "22.2.3",
        "@angular/forms": "22.2.3",
        "@angular/platform-browser": "22.2.3",
        "@angular/platform-browser-dynamic": "22.2.3",
        "@angular/router": "22.2.3",
        "@clerk/clerk-js": "6.37.0",
        "@lucide/angular": "^1.49.0",
        "@tailwindcss/postcss": "^4.3.3",
        "rxjs": "~7.8.1",
        "tslib": "^2.7.0",
        "zod": "4.6.7",
        "zone.js": "^0.16.3"
    },
    "devDependencies": {
        "@angular/build": "^22.2.3",
        "@angular/cli": "22.2.3",
        "@angular/compiler-cli": "22.2.3",
        "@angular/localize": "22.2.3",
        "@biomejs/biome": "2.5.15",
        "@clerk/backend": "^3.22.0",
        "@clerk/testing": "^2.2.42",
        "@playwright/test": "^1.63.0",
        "autoprefixer": "^10.6.1",
        "jsdom": "^30.1.1",
        "ng-extract-i18n-merge": "^3.5.0",
        "postcss": "^8.4.47",
        "postcss-nested": "^8.0.1",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "utf-8-validate": "^6.0.6",
        "vitest": "^5.0.3"
    },
    "overrides": {
        "vite": "8.3.5",
        "image-size": "2.0.3",
        "jayson": {
            "stream-json": "3.5.0",
            "uuid": "11.1.1"
        }
    },
    "packageManager": "npm@11.12.1",
    "engines": {
        "node": "24.x"
    }
}
