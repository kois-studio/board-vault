{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "installCommand": "npx --yes npm@11.12.1 ci --ignore-scripts",
    "headers": [
        {
            "source": "/:file((?:main|polyfills|chunk|styles)-[A-Za-z0-9_-]{8}\\.(?:js|css))",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        }
    ]
}
