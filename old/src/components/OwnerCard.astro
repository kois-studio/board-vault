---
import Image from './Image.astro'

interface Props {
    name: string
    gamesOwned: number
    imageUrl: string
}

const { name, gamesOwned, imageUrl } = Astro.props
---

<div class='flex items-center gap-2'>
    <div class='h-20 w-20'>
        <Image src={imageUrl} />
    </div>
    <div class='flex flex-col items-start'>
        <span class='text-xl'>{name}</span>
        <span><i class='bi bi-joystick'></i> {gamesOwned}</span>
    </div>
</div>
