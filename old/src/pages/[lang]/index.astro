---
import Layout from '../../layouts/Layout.astro'

// Translations stuff
import { generatePaths } from '../../utils'
import { translations } from '../../i18n/translations'
export const getStaticPaths = generatePaths
const { lang } = Astro.params
const t = translations[lang]
console.log(t.games_title)
---

<Layout lang={lang}>
    <div class='container mx-auto pt-8 lg:pt-16 pb-96'>
        <h1 class='text-5xl text-center font-semibold'>Board Vault</h1>
        <p class='text-gray-400 text-center py-8'>A database to organize the table games of your friends group</p>
    </div>
</Layout>

