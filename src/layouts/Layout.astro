---
import '../styles/global.scss'
import { translations } from '../i18n/translations'
import Language from '../components/Language.astro'
import { Account, Session, db, eq } from 'astro:db'

interface Props {
    lang: keyof typeof translations
}

const { lang } = Astro.props
const t = translations[lang]

// Validate session
let isSessionValid: boolean = false
const accessToken = Astro.cookies.get('session_id')

// 1. Check if the session exists
if (accessToken) {
    const sessions = await db
        .select()
        .from(Session)
        .where(eq(Session.sessionId, accessToken.value))

    // 2. Check if the session is valid
    if (sessions.length > 0) {
        const accounts = await db
            .select()
            .from(Account)
            .where(eq(Account.id, Number(sessions[0]?.accountId)))
        const account = accounts[0]
        if (account) {
            isSessionValid = true
        }
    }
}

// styles
const styles_link =
    'b-0 cursor-pointer p-2 text-xl font-bold tracking-wider hover:text-green-600'
---

<!doctype html>
<html lang='en'>
    <head>
        <!-- Global Metadata -->
        <meta charset='utf-8' />
        <meta name='viewport' content='width=device-width,initial-scale=1' />
        <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
        <meta name='generator' content={Astro.generator} />

        <!-- Primary Meta Tags -->
        <title>Board Vault | {t.test}</title>
        <meta name='title' content={t.test} />
        <meta name='description' content={t.test} />

        <!-- Bootstrap & Icons -->
        <link
            rel='stylesheet'
            href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css'
        />

        <!-- Animate CSS -->
        <link
            rel='stylesheet'
            href='https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css'
        />
    </head>
    <body class='bg-zinc-900 text-white'>
        <header class='p-2 border-b border-zinc-500'>
            <nav
                class='animate__animated animate__fadeIn relative flex items-center justify-between px-4'
            >
                <a href={`/${Astro.currentLocale}`} class='' aria-label='Home'>
                    <span class='hidden'>Home</span>
                    <img src='/images/logo.webp' alt='logo' class='w-16' />
                </a>

                <!-- DESKTOP MENU -->
                <div class='hidden lg:block'>
                    <a
                        class={`${styles_link} ${isSessionValid ? '' : 'hidden'}`}
                        href={`/${lang}/`}
                    >
                        Dashboard
                    </a>
                    <a class={styles_link} href={`/${lang}/games`}>Games list</a>

                    <a
                        href={`/${Astro.currentLocale}/login`}
                        class:list={[
                            'rounded bg-green-600 px-4 py-2 text-xl font-bold hover:bg-green-700',
                            `${isSessionValid ? 'hidden' : ''}`,
                        ]}
                    >
                        Log in
                    </a>

                    <button
                        id='signout'
                        class:list={[
                            'rounded bg-red-600 px-4 py-2 text-xl font-bold hover:bg-red-700',
                            `${isSessionValid ? '' : 'hidden'}`,
                        ]}
                    >
                        Sign out
                    </button>
                </div>

                <div class='absolute left-0 top-20 lg:relative lg:top-0'>
                    <Language lang={lang} />
                </div>

                <!-- MOBILE MENU -->
                <button id='menu-btn' class='block text-4xl lg:hidden' aria-label='menu'>
                    <i class='bi bi-list'></i>
                </button>

                <div
                    id='menu'
                    class='absolute right-0 top-20 hidden flex-col items-end lg:hidden'
                >
                    <a class={styles_link} href={`/${lang}/games`}>Games list</a>
                </div>
            </nav>
        </header>

        <main>
            <slot />
        </main>

        <footer class='mt-8 bg-zinc-800 text-white'>
            <div class='container mx-auto grid gap-y-8 px-4 pb-40 pt-8 xl:grid-cols-4'>
                <div class='mx-auto pb-8 xl:mx-0 xl:pb-0'>
                    <img src='/images/logo.webp' alt='logo' class='w-32' />
                </div>
                <div class='flex flex-col items-start'>
                    <h2 class='pb-4 text-3xl font-bold tracking-wider'>{t.test}</h2>
                    <a
                        class='pb-2 hover:underline'
                        href={`/${Astro.currentLocale}/services`}>{t.test}</a
                    >
                    <a class='pb-2 hover:underline' href={`/${Astro.currentLocale}/about`}
                        >{t.test}</a
                    >
                </div>
                <div class='flex flex-col items-start'>
                    <h2 class='pb-4 text-3xl font-bold tracking-wider'>{t.test}</h2>
                    <a class='pb-2 hover:underline' href={`/${Astro.currentLocale}#faq`}
                        >{t.test}</a
                    >
                    <a class='pb-2 hover:underline' href={`/${Astro.currentLocale}/terms`}
                        >{t.test}</a
                    >
                </div>
                <div class='flex flex-col items-start'>
                    <h2 class='pb-4 text-3xl font-bold tracking-wider'>{t.test}</h2>
                    <a
                        class='pb-2 hover:underline'
                        href={`/${Astro.currentLocale}/contact`}>{t.test}</a
                    >
                    <p class='pb-2'>hola@gmail.com</p>
                </div>
            </div>
            <div class='bg-zinc-900 p-4 text-center text-xl'>
                newver.com &copy; {new Date().getFullYear().toString()}
            </div>
        </footer>
    </body>
</html>

<script is:inline>
    // Mobile menu interaction
    const menuBtn = document.querySelectorAll('#menu-btn')[0]
    const menu = document.querySelectorAll('#menu')[0]
    menuBtn.addEventListener('click', () => {
        menu.classList.toggle('hidden')
        menu.classList.toggle('flex')
    })

    // Handle Sign Out
    document.getElementById('signout').addEventListener('click', async () => {
        // Call the sign out endpoint
        const response = await fetch('/api/auth/signout', { method: 'GET' })

        if (response.ok) {
            // Redirect to the homepage or sign-in page after successful sign out
            window.location.href = '/'
        } else {
            // Handle errors (optional)
            console.error('Sign out failed')
        }
    })
</script>

<style is:global>
    html,
    body {
        scroll-behavior: smooth;
        font-family:
            -apple-system,
            BlinkMacSystemFont,
            Segoe UI,
            Roboto,
            Oxygen,
            Ubuntu,
            Cantarell,
            Fira Sans,
            Droid Sans,
            Helvetica Neue,
            sans-serif;
    }
</style>
