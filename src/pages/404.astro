---
import { translations } from '../i18n/translations'
import Layout from '../layouts/Layout.astro'
import Image from '../components/Image.astro'

const lang = Astro.currentLocale as keyof typeof translations ?? 'en'
const t = translations[lang]
---

<Layout lang={lang}>
    <Image src='/images/headers/404.jpg'>
        <div class='animate__animated animate__fadeIn flex min-h-[80vh] grid-cols-2 justify-end bg-zinc-900/50 text-white lg:grid'>
            <div></div>
            <div class='flex flex-col justify-end px-2 py-8 lg:flex lg:w-[36rem] lg:justify-center'>
                <h1 class='pb-4 text-left text-3xl font-bold tracking-wider lg:text-5xl'>Error 404<br /> {'t.error_404_title'}</h1>
                <h2 class='pb-4 text-gray-300'>
                    {'t.error_404_description'}
                </h2>
                <div class='mx-auto lg:ml-0 lg:mr-auto'>
                    <a href={`/${lang}`} class='block rounded bg-blue-600 px-6 py-4 text-xl font-bold hover:bg-blue-700'> {'t.error_404_button'}</a>
                </div>
            </div>
        </div>
    </Image>
</Layout>
