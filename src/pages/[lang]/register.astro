---
import Layout from '../../layouts/Layout.astro'
import RegisterForm from '../../components/forms/RegisterForm.svelte'

// Translations stuff
import { generatePaths } from '../../utils'
import { translations } from '../../i18n/translations'
export const getStaticPaths = generatePaths
const { lang } = Astro.params
const t = translations[lang]

// Other stuff
const { cookies, redirect } = Astro
const accessToken = cookies.get('session_id')

if (accessToken) {
    return redirect(`/${Astro.currentLocale}/`)
}
---

<Layout lang={lang}>
    <h1 class='text-4xl text-center pt-24 lg:pt-48'>Create an account</h1>
    <p class="text-gray-400 text-center py-8">Already have an account? <a href={`/${Astro.currentLocale}/signin`} class="underline">Sign in</a></p>

    <RegisterForm client:load />
</Layout>
