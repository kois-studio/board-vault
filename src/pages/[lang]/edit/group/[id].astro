---
import { db, eq, Account, Group, GroupMembership, Session } from 'astro:db';

/**
 * AUTHENTICATION
 */
const accessToken = Astro.cookies.get('session_id')

const sessions = await db
    .select()
    .from(Session)
    .where(eq(Session.sessionId, accessToken!.value))

const accounts = await db
    .select()
    .from(Account)
    .where(eq(Account.id, Number(sessions[0]?.accountId)))
const account = accounts[0]


/**
 * ...................................
 */
const yourMemberships = await db
    .select()
    .from(GroupMembership)
    .where(eq(GroupMembership.accountId, account!.id))

const groups = (
    await Promise.all(
        yourMemberships.map(
            async membership =>
                (
                    await db.select().from(Group).where(eq(Group.id, membership.groupId))
                )[0],
        ),
    )
).map(group => group?.id)
.filter(Boolean) as number[]



const { id } = Astro.params
---
<h1>{id}: {'post.name'}</h1>