---
import Layout from '../../layouts/Layout.astro'
import { db, Game, OwnedGame, Owner, Session } from 'astro:db'
import { sql } from '@astrojs/db/runtime'
import GamesSelector from '../../components/GamesSelector.svelte'

// Translations stuff
import { translations } from '../../i18n/translations'
import { Account } from 'astro:db'
const { lang } = Astro.params
const t = translations[lang]

// Other stuff
const accessToken = Astro.cookies.get('session_id')
let isValid: boolean = false

if (!accessToken) {
    return Astro.redirect(`/${Astro.currentLocale}/login`)
}

const sessions = await db
    .select()
    .from(Session)
    .where(sql`sessionId = ${accessToken.value}`)

if (sessions.length === 0) {
    Astro.cookies.delete('session_id', { path: '/' })
    return Astro.redirect(`/${Astro.currentLocale}/login`)
}

const accounts = await db
    .select()
    .from(Account)
    .where(sql`id = ${sessions[0]?.accountId!}`)
const account = accounts[0]

if (!account) {
    throw new Error('Account not found')
} else {
    isValid = true
}

// Step 1: load all the owners from your account
const games = await db.select().from(Game)
const ownedGames = await db.select().from(OwnedGame)
const owners = await db
    .select()
    .from(Owner)
    .where(sql`userId = ${account.id}`)
---

<Layout lang={lang as keyof typeof translations}>
    {
        isValid ? (
            <div class='container mx-auto pt-8 lg:pt-16'>
                <h1 class='text-2xl font-bold text-center mb-8'>
                    Select the people who comes to play today
                </h1>

                <div class="flex items-center justify-start mb-2 gap-4">
                    <button
                        title='Edit group'
                        class='block rounded bg-green-600 px-2 hover:bg-green-700'
                    >
                        <i class='bi bi-pencil-square' />
                    </button>
                    <p class='text-lg font-bold'>{account.email} - Group</p>
                </div>
                <hr class='mb-4' />

                <GamesSelector owners={owners} games={games} ownedGames={ownedGames} />

                <button
                    id='signout'
                    class='rounded bg-green-600 px-6 py-4 text-xl font-bold hover:bg-green-700'
                >
                    Sign out
                </button>
            </div>
        ) : (
            <div class='text-center container mx-auto px-4 py-20'>
                <p class='pb-8'>
                    Something went wrong. <br /> Please, sign out and log in again
                </p>
            </div>
        )
    }
</Layout>

<script is:inline>
    // Handle Sign Out
    document.getElementById('signout').addEventListener('click', async () => {
        // Call the sign out endpoint
        const response = await fetch('/api/auth/signout', { method: 'GET' })

        if (response.ok) {
            // Redirect to the homepage or sign-in page after successful sign out
            window.location.href = '/'
        } else {
            // Handle errors (optional)
            console.error('Sign out failed')
        }
    })

    // Add a class to the owner card
    document.querySelectorAll('.dx-ownerCard').forEach(card => {
        card.addEventListener('click', () => {
            // When an owner is clicked, add a class to the card
            card.classList.toggle('bg-zinc-700')
        })
    })
</script>
