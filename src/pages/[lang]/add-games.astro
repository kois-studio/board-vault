---
import Layout from '../../layouts/Layout.astro'
import { db, eq, Game, OwnedGame } from 'astro:db'
import { generatePaths, validateSession } from '../../utils'

// Translations stuff
import { translations } from '../../i18n/translations'
export const getStaticPaths = generatePaths
const { lang } = Astro.params
const t = translations[lang]
console.log(t.test)

// Other stuff
const accessToken = Astro.cookies.get('session_id')?.value ?? null
const account = await validateSession(accessToken)

if (account === null) {
    Astro.cookies.delete('session_id', { path: '/' })
    // Returing a redirect will stop the page from rendering
    return Astro.redirect(`/${Astro.currentLocale}/login`)
}

/**
 * 3. The games that the user has
 */
 const games = await db.select().from(Game)

 const gamesOwned = await db
    .select()
    .from(OwnedGame)
    .where(eq(OwnedGame.accountId, account.id))

const gamesList = games.map(game => {
    const isOwned = gamesOwned.some(ownedGame => ownedGame.gameId === game.id)
    return { ...game, isOwned }
})

---
<Layout lang={lang}>
    <div class='container mx-auto pt-8 lg:pt-16'>
        <h1 class='text-4xl text-center'>Add games</h1>
        <p class='text-gray-400 text-center py-8'>
            This is a list of the games supported in the app, select all the ones you own. <br />
            If you can't your game, request it in the <a href='/{{lang}}/contact' class='text-blue-500'>contact page</a>.
        </p>
        
        <div class="w-96 mx-auto py-8">
            <input id="input-gamefilter" placeholder="filter by game name..." type="text" class="h-12 w-full rounded border-0 p-2 shadow outline-0 ring-green-400 focus:ring-4 bg-zinc-800">
        </div>
        
        <div id="list-games" class='flex gap-2 flex-wrap'>
            {gamesList.map(game => (
                <button class:list={[
                    game.isOwned ? 'border-green-400' : 'opacity-30 border-red-400',
                    "grid grid-rows-2 rounded bg-zinc-700 p-2 w-40 h-60 hover:opacity-100 border-2 cursor-pointer"
                ]}>
                    <div class="bg-cover bg-no-repeat bg-center h-full w-full overflow-hidden" style={`background-image: url(${game.imageUrl});`}/>
                
                    <div class="relative overflow-hidden h-full grid">
                        <h3 class="py-2 text-lg overflow-hidden text-ellipsis whitespace-nowrap">{game.title}</h3>
                        <p><i class="bi bi-clock-fill" /> {game.gameAvgDuration} mins</p>
                        <p><i class="bi bi-people-fill" /> {game.minPlayers} - {game.maxPlayers}</p>
                    </div>
                </button>
            ))}
        </div>
    </div>
</Layout>

<script is:inline>
    // When input-gamefilter changes, filter the list-games
    const inputGameFilter = document.getElementById('input-gamefilter')
    const listGames = document.getElementById('list-games')

    inputGameFilter.addEventListener('input', () => {
        const filter = inputGameFilter.value.toLowerCase()
        const games = listGames.children

        for (let i = 0; i < games.length; i++) {
            const game = games[i]
            const title = game.querySelector('h3').innerText.toLowerCase()
            if (title.includes(filter)) {
                game.classList.remove('hidden')
            } else {
                game.classList.add('hidden')
            }
        }
    })

    // When a game is clicked, toggle the owned class
    listGames.addEventListener('click', (e) => {
        const game = e.target.closest('button')
        game.classList.remove('border-transparent')

        // on the first click, remove red and add green
        game.classList.toggle('border-green-400')
        game.classList.toggle('border-red-400')
        game.classList.toggle('opacity-30')

    })
</script>