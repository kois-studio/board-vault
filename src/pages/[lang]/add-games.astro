---
import Layout from '../../layouts/Layout.astro'
import { db, eq, Game, OwnedGame } from 'astro:db'
import { generatePaths, validateSession } from '../../utils'
import GameList from '../../components/GameList.svelte'

// Translations stuff
import { translations } from '../../i18n/translations'
export const getStaticPaths = generatePaths
const { lang } = Astro.params
const t = translations[lang]
console.log(t.test)

// Other stuff
const accessToken = Astro.cookies.get('session_id')?.value ?? null
const account = await validateSession(accessToken)

if (account === null) {
    Astro.cookies.delete('session_id', { path: '/' })
    // Returing a redirect will stop the page from rendering
    return Astro.redirect(`/${Astro.currentLocale}/login`)
}

/**
 * 3. The games that the user has
 */
 const games = await db.select().from(Game)

 const gamesOwned = await db
    .select()
    .from(OwnedGame)
    .where(eq(OwnedGame.accountId, account.id))

const gamesList = games.map(game => {
    const isOwned = gamesOwned.some(ownedGame => ownedGame.gameId === game.id)
    return { ...game, isOwned }
})

---
<Layout lang={lang}>
    <div class='container mx-auto pt-8 lg:pt-16'>
        <h1 class='text-4xl text-center'>Add games</h1>
        <p class='text-gray-400 text-center py-8'>
            This is a list of the games supported in the app, select all the ones you own. <br />
            If you can't your game, request it in the <a href='/{{lang}}/contact' class='text-blue-500'>contact page</a>.
        </p>

        <GameList games={gamesList} />
    </div>
</Layout>
