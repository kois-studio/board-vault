---
import Layout from '../../layouts/Layout.astro'
import LoginForm from '../../components/forms/LoginForm.svelte'

// Translations stuff
import { generatePaths } from '../../utils'
import { translations } from '../../i18n/translations'
export const getStaticPaths = generatePaths
const { lang } = Astro.params
const t = translations[lang]

// Other stuff
const accessToken = Astro.cookies.get('session_id')

if (accessToken) {
    return Astro.redirect(`/${Astro.currentLocale}/`)
}
---

<Layout lang={lang}>
    <h1 class='text-4xl text-center pt-24 lg:pt-48'>Welcome!</h1>
    <p class='text-gray-400 text-center py-8'>
        <span>New here?</span>
        <a href={`/${Astro.currentLocale}/register`} class='underline'>
            Create an account
        </a>
    </p>

    <LoginForm client:load />
</Layout>
