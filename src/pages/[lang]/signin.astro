---
import Layout from '../../layouts/Layout.astro'

// Translations stuff
import { generatePaths } from '../../utils'
import { translations } from '../../i18n/translations'
export const getStaticPaths = generatePaths
const { lang } = Astro.params
const t = translations[lang]

// Other stuff

const { cookies, redirect } = Astro
const accessToken = cookies.get('session_id')

if (accessToken) {
    return redirect(`/${Astro.currentLocale}/`)
}
---

<Layout lang={lang}>
    <h1 class='text-4xl text-center pt-24 lg:pt-48'>Welcome!</h1>
    <p class="text-gray-400 text-center py-8">New here? <a href={`/${Astro.currentLocale}/register`} class="underline">Create an account</a></p>

    <form class='flex flex-col gap-4 rounded bg-zinc-800 p-8 w-96 mx-auto' action='/api/auth/signin' method='POST'>
        <input class='rounded border border-zinc-700 bg-zinc-800 px-4 py-2' type='email' name='email' placeholder='Email ...' min="4" required />
        <input class='rounded border border-zinc-700 bg-zinc-800 px-4 py-2' type='password' name='password' placeholder='Password ...' min="8" required />
        <button class='rounded bg-green-600 px-6 py-4 text-xl font-bold hover:bg-green-700 lg:col-span-3' type='submit'>Sign in</button>
    </form>
</Layout>
