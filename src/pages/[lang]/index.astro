---

<Layout lang={lang}>
    <h1>Welcome {'email'}</h1>
    <p>We are happy to see you here</p>
    {games.map(game => (
        <div>
            <h2>{game.id}</h2>
            <p>{game.title}</p>
        </div>
    ))}
</Layout>
