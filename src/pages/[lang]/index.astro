---
import Layout from '../../layouts/Layout.astro'

// Translations stuff
import { generatePaths } from '../../utils'
import { translations } from '../../i18n/translations'
export const getStaticPaths = generatePaths
const { lang } = Astro.params
const t = translations[lang]

---

<Layout lang={lang}>
    <div class='container mx-auto pt-8 lg:pt-16'>
        <h1 class='text-4xl text-center'>Board Vault</h1>
        <p class='text-gray-400 text-center py-8'>A database to organize the table games of your friends group</p>

        <a
            href={`/${Astro.currentLocale}/login`}
            class='rounded bg-green-600 px-6 py-4 text-xl font-bold hover:bg-green-700'
        >
            Log in
        </a>
    </div>
</Layout>

