---
import Layout from '../../layouts/Layout.astro'
import { db, Game } from 'astro:db'

// Translations stuff
import { generatePaths } from '../../utils'
import { translations } from '../../i18n/translations'
export const getStaticPaths = generatePaths
const { lang } = Astro.params
const t = translations[lang]

// Other stuff
const games = await db.select().from(Game)
const { cookies, redirect } = Astro
const accessToken = cookies.get('session_id')

async function validateSession() {
    try {
        const response = await fetch('/api/auth/session', { method: 'GET' })
        console.log(1243125)
        const data = await response.json()

        if (!data.valid) {
            redirect(`/${Astro.currentLocale}/login`)
        }
    } catch (error) {
        console.error(error)
    }
}

if (!accessToken) {
    return redirect(`/${Astro.currentLocale}/login`)
} else {
    validateSession()
}


