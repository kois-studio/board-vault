---

<Layout lang={lang}>
    <div class='container mx-auto pt-8 lg:pt-16'>
        <h1 class='text-4xl text-center'>Welcome!</h1>
        <p class='text-gray-400 text-center py-8'>New here?</p>

        <button
            id='signout'
            class='rounded bg-green-600 px-6 py-4 text-xl font-bold hover:bg-green-700'
        >
            Sign out
        </button>
        <p>We are happy to see you here</p>
        {}
        {
            games.map(game => (
                <div>
                    <h2>{game.id}</h2>
                    <p>{game.title}</p>
                </div>
            ))
        }
    </div>
</Layout>

<script is:inline>
    async function handleSignOut() {
        // Call the sign out endpoint
        const response = await fetch('/api/auth/signout', { method: 'GET' })

        if (response.ok) {
            // Redirect to the homepage or sign-in page after successful sign out
            window.location.href = '/signin'
        } else {
            // Handle errors (optional)
            console.error('Sign out failed')
        }
    }

    document.getElementById('signout').addEventListener('click', handleSignOut)
</script>
