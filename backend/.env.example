# Copy to .env for local development. This configuration uses an isolated
# SQLite file and the shared Clerk *development* instance. Never put
# production credentials here. See docs/onboarding.md and docs/environments.md.
NODE_ENV=development
PORT=3000

# Disposable local SQLite database. The URL is relative to the backend cwd.
TURSO_DATABASE_URL=file:../data/board-vault.local.db
TURSO_AUTH_TOKEN=

# Sign-in is Clerk-only. Paste the development-instance keys (pk_test_/sk_test_)
# from the onboarding .env. The frontend reads CLERK_PUBLISHABLE_KEY from here.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:4200,http://localhost:4300
BOARD_VAULT_CLERK_INVITATION_REDIRECT_URL=http://localhost:4200/register
# Optional: turns on POST /webhooks/clerk (ADR-0013). Local Clerk webhooks need a tunnel.
CLERK_WEBHOOK_SIGNING_SECRET=
BOARD_VAULT_SELF_REGISTRATION_ENABLED=true

# Optional local Redis/cache. Keep disabled unless local Upstash values exist.
UPSTASH_REDIS_REST_DISABLE=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional comma-separated browser origins in addition to the local defaults.
CORS_ORIGINS=
