# Copy to .env for local development. This configuration uses an isolated
# SQLite file and synthetic fixture accounts. Do not replace these values with
# production credentials. See docs/contributor-setup.md for Clerk integration.
NODE_ENV=development
PORT=3000

# Disposable local SQLite database. The URL is relative to the backend cwd.
TURSO_DATABASE_URL=file:../data/board-vault.local.db
TURSO_AUTH_TOKEN=

# Local-only legacy session signing key; replace for a shared integration env.
JWT_SECRET=local-only-change-this-development-secret

# Fake key permits local startup but cannot send email.
RESEND_API_KEY=re_local_disabled
NO_REPLY_EMAIL=noreply@example.com
APP_BASE_URL=http://localhost:4300

# Clerk is optional for local development. Only use development-instance keys.
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:4300
BOARD_VAULT_CLERK_INVITATION_REDIRECT_URL=http://localhost:4300/register
BOARD_VAULT_SELF_REGISTRATION_ENABLED=true

# Optional local Redis/cache. Keep disabled unless local Upstash values exist.
UPSTASH_REDIS_REST_DISABLE=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional comma-separated browser origins in addition to the local defaults.
CORS_ORIGINS=
