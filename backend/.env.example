# Copy to .env for local development. Use real secrets only in local ignored
# files or the deployment provider; never commit .env.
NODE_ENV=development
PORT=3000

# Turso/libSQL
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-a-local-or-development-token

# Legacy account migration path
JWT_SECRET=replace-with-a-long-random-development-secret

# Legacy email flows (required by EmailService even while Clerk is enabled)
RESEND_API_KEY=re_replace-with-a-development-key
NO_REPLY_EMAIL=noreply@example.com
APP_BASE_URL=http://localhost:4200

# Clerk development instance
CLERK_SECRET_KEY=sk_test_replace-me
CLERK_AUTHORIZED_PARTIES=http://localhost:4200
BOARD_VAULT_CLERK_INVITATION_REDIRECT_URL=http://localhost:4200/register
BOARD_VAULT_SELF_REGISTRATION_ENABLED=true

# Optional local Redis/cache. Keep disabled unless local Upstash values exist.
UPSTASH_REDIS_REST_DISABLE=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional comma-separated browser origins in addition to the local defaults.
CORS_ORIGINS=
